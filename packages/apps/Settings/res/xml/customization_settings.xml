<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="Advanced Customization">

    <PreferenceCategory
        android:title="Status Bar Plus">

        <SwitchPreference
            android:key="status_bar_battery_bar"
            android:title="Battery Bar"
            android:summary="Show a battery progress bar at the top of the status bar"
            android:defaultValue="false" />

        <SeekBarPreference
            android:key="status_bar_battery_bar_thickness"
            android:title="Battery Bar Thickness"
            android:max="10"
            settings:min="1"
            android:defaultValue="4"
            android:dependency="status_bar_battery_bar" />

        <ListPreference
            android:key="status_bar_battery_bar_color"
            android:title="Battery Bar Color"
            android:entries="@array/battery_bar_color_entries"
            android:entryValues="@array/battery_bar_color_values"
            android:defaultValue="#FFFFFFFF"
            android:dependency="status_bar_battery_bar" />



        <SwitchPreference
            android:key="status_bar_show_nfc"
            android:title="Show NFC Icon"
            android:defaultValue="true" />

        <SwitchPreference
            android:key="status_bar_show_bluetooth"
            android:title="Show Bluetooth Icon"
            android:defaultValue="true" />

        <SwitchPreference
            android:key="status_bar_show_mobile_data"
            android:title="Show Mobile Data Icon"
            android:defaultValue="true" />

        <SwitchPreference
            android:key="network_traffic_state"
            android:title="Network Traffic Monitor"
            android:summary="Show real-time upload/download speeds"
            android:defaultValue="false" />

        <ListPreference
            android:key="network_traffic_mode"
            android:title="Traffic Display Mode"
            android:entries="@array/network_traffic_mode_entries"
            android:entryValues="@array/network_traffic_mode_values"
            android:dependency="network_traffic_state"
            android:defaultValue="0" />

    </PreferenceCategory>


    <PreferenceCategory
        android:title="Quick Settings Pro">

        <ListPreference
            android:key="qs_columns"
            android:title="Quick Settings Columns"
            android:summary="Number of columns in Quick Settings grid"
            android:entries="@array/qs_columns_entries"
            android:entryValues="@array/qs_columns_values"
            android:defaultValue="3" />

        <ListPreference
            android:key="qs_brightness_position"
            android:title="Brightness Slider Position"
            android:entries="@array/qs_brightness_position_entries"
            android:entryValues="@array/qs_brightness_position_values"
            android:defaultValue="0" />

        <SwitchPreference
            android:key="qs_header_image_enabled"
            android:title="QS Header Image"
            android:summary="Show a custom image background in the QS header"
            android:defaultValue="false" />

        <ListPreference
            android:key="qs_header_image"
            android:title="Select Header Image"
            android:entries="@array/qs_header_image_entries"
            android:entryValues="@array/qs_header_image_values"
            android:dependency="qs_header_image_enabled"
            android:defaultValue="0" />

    </PreferenceCategory>


    <PreferenceCategory
        android:title="Lockscreen Mods">

        <ListPreference
            android:key="lockscreen_clock_font"
            android:title="Clock Font"
            android:entries="@array/lockscreen_clock_font_entries"
            android:entryValues="@array/lockscreen_clock_font_values"
            android:defaultValue="0" />

        <SwitchPreference
            android:key="double_tap_sleep_lockscreen"
            android:title="Double-tap to Sleep"
            android:summary="Double-tap on empty area of lockscreen to put device to sleep"
            android:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="Navigation &amp; Gestures">

        <SeekBarPreference
            android:key="gesture_pill_width"
            android:title="Gesture Pill Width"
            android:max="200"
            settings:min="50"
            android:defaultValue="100" />

        <SeekBarPreference
            android:key="gesture_pill_thickness"
            android:title="Gesture Pill Thickness"
            android:max="200"
            settings:min="50"
            android:defaultValue="100" />

        <SwitchPreference
            android:key="volume_skip_tracks"
            android:title="Volume Skip Tracks"
            android:summary="Long-press volume buttons when screen is off to skip tracks"
            android:defaultValue="false" />

        <SwitchPreference
            android:key="advanced_reboot"
            android:title="Advanced Reboot"
            android:summary="Show Recovery and Bootloader options in the reboot menu"
            android:defaultValue="false" />

    </PreferenceCategory>


</PreferenceScreen>
